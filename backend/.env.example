# ==============================================================================
# PROJECT ANARA — UNIVERSAL ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Anara is provider-agnostic and multi-user ready!
# Any user can freely select their preferred AI model provider:
# - Cloud frontier models (OpenAI, Anthropic Claude, Google Gemini, Groq, DeepSeek)
# - Custom API routers (9Router, OpenRouter)
# - 100% Local offline models (Ollama, vLLM, LM Studio)
#
# Configuration Hierarchy (Hermes Standard):
# 1. Web Studio / Desktop UI (Saved in %LOCALAPPDATA%/anara/anara_brain.db)
# 2. User Runtime .env (%LOCALAPPDATA%/anara/.env)
# 3. Project Workspace .env (backend/.env)
# 4. Host OS Environment Variables
# ==============================================================================

# ── 1. ACTIVE MODEL SELECTION ──
# Set your primary agent reasoning model here:
DEFAULT_AI_MODEL=9router/ag/gemini-3.8-flash-high
FALLBACK_AI_MODEL=9router/ag/gemini-3.8-flash-high
DEFAULT_VOICE_MODEL=gemini-3.1-flash-live-preview

# ── 2. FRONTIER MODEL PROVIDER API KEYS (Fill one or more) ──
# Google AI Studio / Gemini:
GEMINI_API_KEY=

# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini):
OPENAI_API_KEY=

# Anthropic (Claude 3.5 Sonnet, Claude 3.7 Sonnet, Haiku):
ANTHROPIC_API_KEY=

# Groq (Llama 3.3 70B, Mixtral):
GROQ_API_KEY=

# DeepSeek (DeepSeek-V3, DeepSeek-R1):
DEEPSEEK_API_KEY=

# ── 3. CUSTOM ROUTERS & LOCAL PROVIDERS (9Router, OpenRouter, Ollama, vLLM) ──
CUSTOM_PROVIDER_NAME=9router
CUSTOM_PROVIDER_PREFIX=9router
CUSTOM_PROVIDER_BASE_URL=https://api.9router.com/v1
CUSTOM_PROVIDER_API_KEY=

# Local Ollama (Uncomment and set if using local models without cloud APIs):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2

# ── 4. MULTI-CHANNEL COMMUNICATION & MESSAGING (Optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_PHONE_NUMBER=
WA_BRIDGE_PORT=8001
GOOGLE_USER_EMAIL=

# ── 5. RUNTIME & SYSTEM CONFIGURATION ──
ANARA_WORKSPACE_DIR=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SYSTEM_PROMPT="Kamu adalah Anara, asisten AI otonom multi-modal yang cerdas, proaktif, dan berempati. Sesuaikan selalu bahasa responmu dengan bahasa aktif pengguna."
