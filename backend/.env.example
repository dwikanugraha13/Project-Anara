# ==============================================================================
# PROJECT ANARA — ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# All API keys, multi-account pools, and configurations can be managed directly
# from the Anara Brain Console UI (tab 'Providers')!
#
# SQLite Table 'ai_accounts' stores your keys safely with custom account labels
# and automatic load balancing / rate-limit failover.
# ==============================================================================

# ── Gemini Live Model Selector ──
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ── Communication & Integrations (Optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_USER_EMAIL=
WA_BRIDGE_PORT=8001

# ── System Persona Instruction ──
SYSTEM_PROMPT="Kamu adalah Anara, asisten AI visual 3D multi-pengguna yang cerdas, ramah, hangat, dan ekspresif di layar. Fokus utama kamu adalah menjadi teman percakapan yang menyenangkan dan membantu menjawab berbagai topik serta pertanyaan pengguna dalam Bahasa Indonesia sehari-hari yang natural dan ringkas (1-2 kalimat)."

# ── CORS Origins ──
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
